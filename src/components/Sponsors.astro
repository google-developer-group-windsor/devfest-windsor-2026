
---
interface Sponsor {
  name: string;
  logo: string;
  url: string;
  color: "blue" | "red" | "amber" | "green" | "cyan" | "purple" | "pink";
  custom?: "dashdev";
}

const sponsors: Sponsor[] = [
  {
    name: "Google",
    logo: "/googleLogo.png",
    url: "https://google.com",
    color: "blue",
  },

  /*
   * DASHDEV STUDIO — TEMPORARILY HIDDEN
   * Uncomment this object when ready to publish.
   *
  {
    name: "DashDev Studio",
    logo: "",
    url: "https://dashdevstudio.com/",
    color: "purple",
    custom: "dashdev",
  },
  */

  {
    name: "School of Business",
    logo: "/schoolOfBusiness.png",
    url: "https://www.uwindsor.ca/business/",
    color: "amber",
  },
  {
    name: "School of Computer Science",
    logo: "/sponsors/univercityOfWindsorTransparent2.webp",
    url: "https://www.uwindsor.ca/science/computerscience/",
    color: "blue",
  },
  {
    name: "WEtech Alliance",
    logo: "/sponsors/WEtech-logo-main.webp",
    url: "https://www.wetech-alliance.com/",
    color: "green",
  },
  {
    name: "DataRealm",
    logo: "/sponsors/DataRealm.png",
    url: "https://www.datarealminc.com/",
    color: "cyan",
  },
  {
    name: "Rocket Innovation Studio",
    logo: "/sponsors/Rocket.svg",
    url: "https://www.rocketinnovationstudio.com/",
    color: "blue",
  },
  {
    name: "RIIS",
    logo: "/sponsors/RIIS.png",
    url: "https://www.riis.com/",
    color: "red",
  },
  {
    name: "Asamaka Industries Ltd",
    logo: "/sponsors/asamaka.png",
    url: "https://www.asamaka.com/",
    color: "purple",
  },
  {
    name: "Social Fizz",
    logo: "/sponsors/socialfizz.webp",
    url: "https://socialfizz.ca/",
    color: "red",
  },
  {
    name: "Packt Publishing",
    logo: "/sponsors/Packt.svg",
    url: "https://www.packtpub.com/en-ca",
    color: "amber",
  },
  {
    name: "EF Hult Prize",
    logo: "/sponsors/HultPrizelogo2.png",
    url: "http://hultprizeuwindsor.ca/",
    color: "purple",
  },
  {
    name: "Black Boys Code",
    logo: "/sponsors/blackCodeBoys.webp",
    url: "https://blackboyscode.ca/locations/windsor/",
    color: "green",
  },
  {
    name: "Black Girls Code",
    logo: "/sponsors/blackCodeGirls.webp",
    url: "https://blackkidscode.com/locations/windsor/",
    color: "pink",
  },
  {
    name: "Southwestern Ontario Cybersecurity Hub",
    logo: "/sponsors/swocts.webp",
    url: "https://www.swocts.com/",
    color: "cyan",
  },
  {
    name: "Computer Science Society",
    logo: "/sponsors/css.webp",
    url: "https://css.uwindsor.ca/",
    color: "amber",
  },
  {
    name: "IEEE Windsor Section",
    logo: "/sponsors/ieee.webp",
    url: "https://windsor.ieee.ca/",
    color: "blue",
  },
  {
    name: "Good Point Consulting",
    logo: "/sponsors/goodPointConsulting.webp",
    url: "https://www.goodpointconsulting.com/home",
    color: "pink",
  },
  {
    name: "Kylie Kiser",
    logo: "/sponsors/Kylie.webp",
    url: "https://kyliekiser.com/",
    color: "purple",
  },
  {
    name: "Adopli AI",
    logo: "/sponsors/adopli-ai.png",
    url: "https://www.adopliai.com/",
    color: "cyan",
  },
  {
    name: "PulseAI",
    logo: "/sponsors/pulseai-lockup-light.webp",
    url: "https://pulseai.now/",
    color: "green",
  },
  {
    name: "ScholarTrack.Ai",
    logo: "/sponsors/scholartrack-transparent.webp",
    url: "https://www.scholartrack.ai/",
    color: "blue",
  },
  {
    name: "Nerdiz",
    logo: "/sponsors/nerdiz-transparent.webp",
    url: "https://www.nerdiz.com/",
    color: "amber",
  },
  {
    name: "ONRx",
    logo: "/sponsors/onrx-logo-transparent.webp",
    url: "https://www.onrx.ca/",
    color: "purple",
  },
  {
    name: "YQG Technologies Inc.",
    logo: "/sponsors/yqg-technology-transparent.webp",
    url: "https://www.yqgtech.com/",
    color: "blue",
  },
  {
    name: "Genio Tech Robotics",
    logo: "/sponsors/genorobotics.webp",
    url: "https://geniotech.ca/",
    color: "blue",
  },
  {
    name: "FieldNote AI",
    logo: "/sponsors/fieldnote-ai.png",
    url: "https://www.fieldsnotesai.com/",
    color: "blue",
  },
];
---

<section
  id="sponsors"
  class="py-12 sm:py-20 bg-white"
  aria-labelledby="sponsors-title"
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">

    <!-- Section header -->
    <div class="mb-12 sm:mb-16 pl-4 sm:pl-8 text-left">
      <h2
        id="sponsors-title"
        class="text-sm font-bold tracking-widest text-blue-600 uppercase"
        data-i18n="sponsors.label"
      >
        Sponsors & Partners
      </h2>

      <!-- Google color lines -->
      <div
        class="flex gap-1 mt-3 h-1 w-24 sm:w-32"
        aria-hidden="true"
      >
        <span class="flex-1 bg-blue-600 rounded"></span>
        <span class="flex-1 bg-red-600 rounded"></span>
        <span class="flex-1 bg-yellow-500 rounded"></span>
        <span class="flex-1 bg-green-600 rounded"></span>
      </div>
    </div>

    <!-- Sponsors grid -->
    <div class="sponsors-grid">
      {
        sponsors.map((sponsor) => (
          <a
            href={sponsor.url}
            target="_blank"
            rel="noopener noreferrer"
            class:list={[
              "sponsor-card",
              `sponsor-color-${sponsor.color}`,
              sponsor.custom === "dashdev" && "sponsor-card-dashdev",
            ]}
            title={sponsor.name}
            aria-label={`${sponsor.name} (opens in a new tab)`}
          >
            {sponsor.custom === "dashdev" ? (
              <!-- DashDev animated logo -->
              <div class="dashdev-logo" aria-hidden="true">

                <!-- Orbiting yellow ball -->
                <span class="dashdev-orbit">
                  <span class="dashdev-ball"></span>
                </span>

                <!-- Brand wordmark -->
                <div class="dashdev-wordmark">
                  <span class="dashdev-name">
                    <span class="dashdev-dash">DASH</span>
                    <span class="dashdev-dev">DEV</span>
                  </span>
                  <span class="dashdev-studio">STUDIO</span>
                </div>

                <!-- Purple glow -->
                <span class="dashdev-trail"></span>

                <!-- Sparkles -->
                <span class="dashdev-spark dashdev-spark-1"></span>
                <span class="dashdev-spark dashdev-spark-2"></span>
                <span class="dashdev-spark dashdev-spark-3"></span>
              </div>
            ) : (
              <!-- Standard sponsor logo -->
              <>
                <div
                  class="blob-shape"
                  aria-hidden="true"
                ></div>

                <div class="logo-container">
                  <img
                    src={sponsor.logo}
                    alt={sponsor.name}
                    loading="lazy"
                    decoding="async"
                    class:list={[
                      "sponsor-logo",
                      sponsor.name === "Asamaka Industries Ltd" &&
                        "asamaka-logo",
                    ]}
                  />
                </div>
              </>
            )}
          </a>
        ))
      }
    </div>
  </div>
</section>

<style>
  /* Section */

  #sponsors {
    scroll-margin-top: 6rem;
  }

  /* Sponsor color palette */

  .sponsor-color-blue {
    --sponsor-accent: #2563eb;
    --sponsor-ring: rgb(37 99 235 / 40%);
  }

  .sponsor-color-red {
    --sponsor-accent: #dc2626;
    --sponsor-ring: rgb(220 38 38 / 40%);
  }

  .sponsor-color-amber {
    --sponsor-accent: #f59e0b;
    --sponsor-ring: rgb(245 158 11 / 40%);
  }

  .sponsor-color-green {
    --sponsor-accent: #16a34a;
    --sponsor-ring: rgb(22 163 74 / 40%);
  }

  .sponsor-color-cyan {
    --sponsor-accent: #06b6d4;
    --sponsor-ring: rgb(6 182 212 / 40%);
  }

  .sponsor-color-purple {
    --sponsor-accent: #9333ea;
    --sponsor-ring: rgb(147 51 234 / 40%);
  }

  .sponsor-color-pink {
    --sponsor-accent: #db2777;
    --sponsor-ring: rgb(219 39 119 / 40%);
  }

  /* Responsive grid */

  .sponsors-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.875rem;
    padding: 0 0.25rem;
    align-items: stretch;
  }

  @media (min-width: 640px) {
    .sponsors-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 1.5rem;
      padding: 0 1rem;
    }
  }

  @media (min-width: 1024px) {
    .sponsors-grid {
      grid-template-columns: repeat(4, minmax(0, 1fr));
      gap: 2rem;
      padding: 0 2rem;
    }
  }

  /* Standard sponsor cards */

  .sponsor-card {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;

    width: 100%;
    min-width: 0;
    min-height: 145px;
    padding: 1rem;

    background: #f9fafb;
    border: 1px solid #e5e7eb;
    border-radius: 1rem;

    overflow: hidden;
    isolation: isolate;
    text-decoration: none;

    transition:
      transform 0.3s ease,
      box-shadow 0.3s ease,
      border-color 0.3s ease,
      background 0.4s ease;
  }

  .sponsor-card:hover {
    transform: translateY(-5px);
    border-color: #cbd5e1;
    box-shadow: 0 14px 30px rgb(0 0 0 / 9%);
  }

  /* Decorative sponsor color blob */

  .blob-shape {
    position: absolute;
    inset: 0;
    z-index: 0;

    background: var(--sponsor-accent, #2563eb);
    border-radius: 30% 70% 70% 30%;

    opacity: 0.08;
    transform: scale(0);
    pointer-events: none;

    transition: transform 0.3s ease;
  }

  .sponsor-card:hover .blob-shape,
  .sponsor-card:focus-visible .blob-shape {
    transform: scale(1);
  }

  /* Logo container */

  .logo-container {
    position: relative;
    z-index: 2;

    display: flex;
    align-items: center;
    justify-content: center;

    width: 100%;
    min-width: 0;
    min-height: 95px;
    padding: 0.5rem;

    border-radius: 0.5rem;
    box-shadow: 0 0 0 4px transparent;

    overflow: visible;

    transition: box-shadow 0.3s ease;
  }

  .sponsor-card:hover .logo-container,
  .sponsor-card:focus-visible .logo-container {
    box-shadow: 0 0 0 4px var(--sponsor-ring, rgb(37 99 235 / 40%));
  }

  /* Sponsor images */

  .sponsor-logo {
    display: block;
    width: 100%;
    height: 80px;

    object-fit: contain;
    object-position: center;

    transition: transform 0.3s ease;
  }

  .sponsor-card:hover .sponsor-logo {
    transform: scale(1.06);
  }

  /* Asamaka logo enlargement */

  .sponsor-logo.asamaka-logo {
    transform: scale(1.3);
    transform-origin: center;
  }

  .sponsor-card:hover .sponsor-logo.asamaka-logo {
    transform: scale(1.38);
  }

  /* DashDev card */

  .sponsor-card-dashdev {
    background: transparent;
    border-color: #e5e7eb;
    isolation: isolate;
  }

  .sponsor-card-dashdev:hover,
  .sponsor-card-dashdev:focus-visible {
    background: linear-gradient(
      135deg,
      #fff0f7 0%,
      #fce7f3 32%,
      #f3e8ff 68%,
      #e9d5ff 100%
    );

    border-color: #c084fc;

    box-shadow:
      0 12px 30px rgba(168, 85, 247, 0.12),
      0 0 26px rgba(217, 70, 239, 0.16);
  }

  /* DashDev logo container */

  .dashdev-logo {
    position: relative;

    display: flex;
    align-items: center;
    justify-content: center;

    width: 100%;
    min-width: 0;
    height: 110px;

    isolation: isolate;
  }

  /* DashDev wordmark */

  .dashdev-wordmark {
    position: relative;
    z-index: 3;

    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;

    min-width: 0;
    transform: translateX(4%);
  }

  .dashdev-name {
    display: flex;
    align-items: baseline;
    justify-content: center;

    font-family: Arial, Helvetica, sans-serif;
    font-size: clamp(1.1rem, 2vw, 1.7rem);
    font-weight: 800;
    letter-spacing: -0.055em;
    line-height: 1.1;
    white-space: nowrap;
  }

  .dashdev-dash {
    color: #171717;
  }

  .dashdev-dev {
    background: linear-gradient(
      110deg,
      #ffb76d 0%,
      #ef8d9b 45%,
      #d35dba 100%
    );

    background-clip: text;
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  .dashdev-studio {
    display: block;
    width: 100%;

    margin-top: 0.3rem;
    padding-left: 0.5em;

    color: #777;

    font-family: Arial, Helvetica, sans-serif;
    font-size: clamp(0.4rem, 0.8vw, 0.6rem);
    font-weight: 700;
    letter-spacing: 0.55em;
    text-align: center;
  }

  /* Yellow orbiting ball */

  .dashdev-orbit {
    position: absolute;
    z-index: 2;

    width: 94px;
    height: 94px;

    left: 5%;
    top: 50%;
    margin-top: -47px;

    border: 1px dashed rgba(234, 179, 8, 0.2);
    border-radius: 50%;

    animation: dashdev-rotate 8s linear infinite;

    transition:
      border-color 0.3s ease,
      filter 0.3s ease;
  }

  .dashdev-ball {
    position: absolute;

    width: 15px;
    height: 15px;

    top: 50%;
    left: 100%;

    transform: translate(-50%, -50%);
    border-radius: 50%;

    background: radial-gradient(
      circle at 30% 30%,
      #fff8b0 0%,
      #facc15 50%,
      #eab308 100%
    );

    box-shadow:
      0 0 12px rgba(250, 204, 21, 0.65),
      0 0 24px rgba(250, 204, 21, 0.25);

    transition:
      width 0.3s ease,
      height 0.3s ease,
      box-shadow 0.3s ease;
  }

  @keyframes dashdev-rotate {
    from {
      transform: rotate(0deg);
    }

    to {
      transform: rotate(360deg);
    }
  }

  /* DashDev faster orbit on hover */

  .sponsor-card-dashdev:hover .dashdev-orbit,
  .sponsor-card-dashdev:focus-visible .dashdev-orbit {
    animation-duration: 1.8s;
    border-color: rgba(168, 85, 247, 0.65);
    filter: drop-shadow(
      0 0 8px rgba(192, 132, 252, 0.45)
    );
  }

  .sponsor-card-dashdev:hover .dashdev-ball,
  .sponsor-card-dashdev:focus-visible .dashdev-ball {
    width: 19px;
    height: 19px;

    box-shadow:
      0 0 15px rgba(250, 204, 21, 0.95),
      0 0 32px rgba(250, 204, 21, 0.5);
  }

  /* Purple glow */

  .dashdev-trail {
    position: absolute;
    z-index: 1;

    width: 125px;
    height: 125px;

    left: 0;
    top: 50%;

    transform: translateY(-50%) scale(0.8);
    border-radius: 50%;

    background: radial-gradient(
      circle,
      rgba(217, 70, 239, 0.18) 0%,
      rgba(168, 85, 247, 0.08) 48%,
      transparent 72%
    );

    opacity: 0;

    transition:
      opacity 0.4s ease,
      transform 0.4s ease;
  }

  .sponsor-card-dashdev:hover .dashdev-trail,
  .sponsor-card-dashdev:focus-visible .dashdev-trail {
    opacity: 1;
    transform: translateY(-50%) scale(1.2);
  }

  /* Purple sparkles */

  .dashdev-spark {
    position: absolute;
    z-index: 2;

    width: 5px;
    height: 5px;

    border-radius: 50%;
    background: #d946ef;

    box-shadow:
      0 0 8px rgba(217, 70, 239, 0.5);

    opacity: 0;
    pointer-events: none;
  }

  .dashdev-spark-1 {
    top: 25%;
    left: 18%;
  }

  .dashdev-spark-2 {
    top: 70%;
    left: 35%;
  }

  .dashdev-spark-3 {
    top: 32%;
    right: 12%;
  }

  .sponsor-card-dashdev:hover .dashdev-spark,
  .sponsor-card-dashdev:focus-visible .dashdev-spark {
    animation: dashdev-sparkle 1.2s ease-in-out infinite;
  }

  .sponsor-card-dashdev:hover .dashdev-spark-2,
  .sponsor-card-dashdev:focus-visible .dashdev-spark-2 {
    animation-delay: 0.3s;
  }

  .sponsor-card-dashdev:hover .dashdev-spark-3,
  .sponsor-card-dashdev:focus-visible .dashdev-spark-3 {
    animation-delay: 0.6s;
  }

  @keyframes dashdev-sparkle {
    0%,
    100% {
      opacity: 0;
      transform: scale(0.4);
    }

    50% {
      opacity: 1;
      transform: scale(1.5);
    }
  }

  /* Mobile layout */

  @media (max-width: 639px) {
    .sponsors-grid {
      gap: 0.75rem;
    }

    .sponsor-card {
      min-height: 120px;
      padding: 0.625rem;
      border-radius: 0.75rem;
    }

    .logo-container {
      min-height: 80px;
      padding: 0.25rem;
    }

    .sponsor-logo {
      height: 70px;
    }

    .dashdev-logo {
      height: 95px;
    }

    .dashdev-wordmark {
      transform: translateX(7%);
    }

    .dashdev-name {
      font-size: clamp(0.9rem, 3.9vw, 1.25rem);
    }

    .dashdev-studio {
      font-size: 0.4rem;
      letter-spacing: 0.38em;
    }

    .dashdev-orbit {
      width: 62px;
      height: 62px;
      left: 0;
      margin-top: -31px;
      animation-duration: 7s;
    }

    .dashdev-ball {
      width: 11px;
      height: 11px;
    }

    .dashdev-trail {
      width: 90px;
      height: 90px;
    }
  }

  /* Extra-small mobile */

  @media (max-width: 359px) {
    .sponsors-grid {
      gap: 0.5rem;
    }

    .sponsor-card {
      padding: 0.4rem;
    }

    .dashdev-name {
      font-size: 0.83rem;
    }

    .dashdev-studio {
      font-size: 0.35rem;
      letter-spacing: 0.3em;
    }

    .dashdev-orbit {
      width: 52px;
      height: 52px;
      margin-top: -26px;
    }
  }

  /* Keyboard accessibility */

  .sponsor-card:focus-visible {
    outline: 3px solid #2563eb;
    outline-offset: 5px;
  }

  /* Reduced motion */

  @media (prefers-reduced-motion: reduce) {
    .sponsor-card,
    .logo-container,
    .sponsor-logo,
    .dashdev-orbit,
    .dashdev-ball,
    .dashdev-trail,
    .blob-shape {
      transition: none !important;
    }

    .dashdev-orbit,
    .dashdev-spark {
      animation: none !important;
    }

    .sponsor-card:hover {
      transform: none !important;
    }

    .sponsor-card:hover .sponsor-logo {
      transform: none !important;
    }

    .sponsor-card:hover .sponsor-logo.asamaka-logo {
      transform: scale(1.3) !important;
    }
  }
</style>
